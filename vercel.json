{
    "builds": [
        {
            "src": "frontend/package.json",
            "use": "@vercel/next",
            "config": {
                "rootDirectory": "frontend"
            }
        }
    ],
    "routes": [
        {
            "src": "/_next/static/(?:[^/]+/pages|chunks|runtime)",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        }
    ]
}